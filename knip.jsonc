{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    "apps/mobile": {
      "entry": [
        // Metro resolves these platform variants without a literal import of the suffixed file.
        "components/ui/icon-symbol.ios.tsx",
        "hooks/use-color-scheme.web.ts",
      ],
      "ignoreDependencies": [
        // Expo's app-config introspection exposes this optional built-in even when EAS Update is not configured.
        "expo-updates",
        // Required at runtime as a peer of the React Native Storybook on-device UI.
        "react-native-svg",
      ],
    },
    "packages/shared": {
      "includeEntryExports": true,
    },
  },
}
