{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    "apps/mobile": {
      "entry": [
        // Metro resolves these platform variants without a literal import of the suffixed file.
        "**/*.{ios,android,windows,web,native,default}.{js,jsx,ts,tsx}",
      ],
      "ignoreDependencies": [
        // Expo's app-config introspection exposes this optional built-in even when EAS Update is not configured.
        "expo-updates",
      ],
    },
    "packages/shared": {
      "includeEntryExports": true,
    },
  },
}
